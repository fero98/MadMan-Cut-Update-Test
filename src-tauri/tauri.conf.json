{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MadMan Cut Update Test",
  "version": "0.1.3-alpha",
  "identifier": "cz.madman.cut.update-test",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MadMan Cut Update Test",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "dragDropEnabled": true,
        "theme": "Dark",
        "backgroundColor": "#060607",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 24
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:*; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'",
      "devCsp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:* ws://localhost:1420; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEwNDExRjA0MjQ2MThFMDgKUldRSWptRWtCQjlCb0VSd2Q0UHlRd2ZUWlJIeFNaYTlzOUptUlRNdEVCZ3JHdkVhdzBKTVFYcU0K",
      "endpoints": [
        "https://github.com/fero98/MadMan-Cut-Update-Test/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "license": "GPL-3.0-or-later",
    "homepage": "https://nuzky.app",
    "licenseFile": "../LICENSE",
    "category": "Video",
    "shortDescription": "A local desktop video editor",
    "macOS": {
      "minimumSystemVersion": "14.0"
    },
    "windows": {
      "bundleVCRuntime": true,
      "nsis": {
        "installerIcon": "icons-madman-v2/icon.ico"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libvulkan1"
        ]
      }
    },
    "icon": [
      "icons-madman-v2/32x32.png",
      "icons-madman-v2/128x128.png",
      "icons-madman-v2/128x128@2x.png",
      "icons-madman-v2/icon.png",
      "icons-madman-v2/icon.ico",
      "icons-madman-v2/icon.icns"
    ],
    "createUpdaterArtifacts": true
  }
}
